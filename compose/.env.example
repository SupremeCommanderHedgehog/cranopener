# Copy to ~/.cranopener/.env and fill in. Never commit the result.

# --- gateway credentials (proxied mode) ---
CAPRA_API_KEY=
DGX_API_KEY=
GENAI_API_KEY=

# --- stock provider credentials (direct mode) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- corporate egress ---
# Leave blank if the environment already exports these.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# CRANOPENER_WORKSPACE is set by cranopener.ps1 on every invocation. Do not
# set it here -- a fixed value would point every project at one directory,
# and the symptom would be edits landing in the wrong repository.
